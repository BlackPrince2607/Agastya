# Copy to `.env` and fill in real values. Never commit `.env` to git.

APP_NAME=Agastya API
# Set DEBUG=false in production — enables extra CORS localhost regex in dev only
DEBUG=false

# API prefix (included in main.py router mount)
API_V1_PREFIX=/v1

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Production: replace with your actual web/app origins.
# Expo dev: add LAN IPs as needed.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,https://agastya.app

# HTTPS Expo tunnels (matched in addition to CORS_ORIGINS):
# CORS_ORIGIN_REGEX=https://.*\.exp\.direct

# ─── Palm Analysis ────────────────────────────────────────────────────────────
# dummy = hash-only (no AI, for local dev/tests)
# vision = OpenRouter vision LM when OPENROUTER_API_KEY + image present
# hybrid = real MediaPipe landmarks + vision narrative when landmarksSource=mediapipe
PALM_ANALYSIS_MODE=vision

# Optional Redis URL for shared rate limits across workers (Upstash/Fly Redis)
# REDIS_URL=redis://localhost:6379/0

# Comma-separated trusted hosts for TrustedHostMiddleware (production)
# TRUSTED_HOSTS=api.agastya.app

# ─── OpenRouter ───────────────────────────────────────────────────────────────
# Required for AI. Create key at https://openrouter.ai/keys (NOT platform.openai.com).
# Quickstart: https://openrouter.ai/docs/quickstart
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
# Vision (palm photos): use a multimodal slug — openai/gpt-4o-mini or openai/gpt-4o
# Invalid on OpenRouter: openai/gpt-4o-vision
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
OPENROUTER_CHAT_TIMEOUT_SECONDS=60
OPENROUTER_VISION_TIMEOUT_SECONDS=90
OPENROUTER_APP_URL=https://agastya.app
OPENROUTER_APP_NAME=Agastya
# ALLOW_LLM_FALLBACK=true

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Required for session persistence and palm image storage.
# Run all migrations in supabase/migrations/ before first deploy.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# JWKS cache TTL in seconds (default 600). User JWTs are verified via JWKS at {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# SUPABASE_JWKS_CACHE_SECONDS=600
# Legacy Supabase projects may still issue HS256 user tokens. Leave empty for JWKS projects.
# SUPABASE_JWT_SECRET=
SUPABASE_PALM_BUCKET=palms

# RevenueCat Webhook ───────────────────────────────────────────────────────
# Optional for prototype / Railway deploy — premium webhooks disabled when unset.
# Required before enabling RevenueCat → Integrations → Webhooks.
REVENUECAT_WEBHOOK_SECRET=

# Founder / tester emails that always get is_premium on merge/bootstrap (comma-separated).
# PREMIUM_EMAIL_ALLOWLIST=sohambhalotia@gmail.com

# ─── Stripe (web Checkout) ──────────────────────────────────────────────────────
# Secret key from Stripe Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=
# Webhook signing secret from Stripe → Developers → Webhooks → endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=
# Price IDs for monthly/annual subscription products (Stripe → Products → Pricing).
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# ─── Sentry ───────────────────────────────────────────────────────────────────
# Backend DSN from https://sentry.io → Python project → Client Keys.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
