# =============================================================================
# Agastya — frontend environment template
#
#   copy env.example .env          (repo root — for Expo / Metro)
#   copy backend\.env.example backend\.env   (API server secrets)
#
# `.env` = your real values (gitignored). This file = safe template (committed).
# Restart Expo after changes: npx expo start -c
# =============================================================================

# ─── API ──────────────────────────────────────────────────────────────────────
# Local dev (emulator): http://localhost:8000 or http://10.0.2.2:8000 (Android emu)
# Physical device on Wi‑Fi: auto LAN IP from app.config.js, or set EXPO_PUBLIC_AGASTYA_API_LAN_URL
# Production / APK: HTTPS Railway URL (also set in eas.json for EAS builds)
EXPO_PUBLIC_AGASTYA_API_URL=http://localhost:8000
# EXPO_PUBLIC_AGASTYA_API_URL=https://agastya-production-b395.up.railway.app
#
# If Expo Go shows "Network request failed" for Railway but Chrome on the phone works:
# your hotspot/carrier DNS is blocking *.up.railway.app. Fix: Android Private DNS → dns.google.
# Diagnose from PC: npm run api:check-dns

# ─── Supabase (client) ───────────────────────────────────────────────────────
# Dashboard → Project Settings → API
# Backend also needs SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY (backend/.env.example)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: hide sign-in methods on account screens
# EXPO_PUBLIC_EMAIL_SIGNIN=false
# EXPO_PUBLIC_OAUTH_SIGNIN=false

# Supabase → Authentication → URL configuration → Redirect URLs:
#   agastya://**   agastya://auth/callback   exp://** (Expo Go)
#   http://localhost:8081/auth/callback (web dev)

# ─── EAS / APK builds ─────────────────────────────────────────────────────────
# Cloud builds use eas.json (prototype profile) + expo.dev Environment variables.
# Local `.env` is NOT used by EAS unless you mirror vars in the dashboard.
# Minimum for shareable APK: EXPO_PUBLIC_SUPABASE_* + API URL in eas.json

# Founder / tester emails that skip the paywall (comma-separated).
# EXPO_PUBLIC_PREMIUM_EMAIL_ALLOWLIST=sohambhalotia@gmail.com

# ─── Billing (Android India — monthly/annual + Play User Choice) ──────────────
# Play Console subscription SKUs for User Choice Billing dialog.
# EXPO_PUBLIC_PLAY_PRODUCT_MONTHLY=premium_monthly
# EXPO_PUBLIC_PLAY_PRODUCT_ANNUAL=premium_annual
# EXPO_PUBLIC_BILLING_CONFIG_CACHE_MS=60000
# Default Indian state code for alt-billing tax reporting (e.g. KA).
# EXPO_PUBLIC_BILLING_DEFAULT_ADMIN_AREA=KA
# DEBUG-only: skip Play User Choice and open Razorpay directly (local E2E / prototype APK).
# Never enable on production / Closed Testing store builds.
# EXPO_PUBLIC_BILLING_RAZORPAY_TEST_BYPASS=true

# ─── Sentry / analytics (optional) ───────────────────────────────────────────
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_MIXPANEL_TOKEN=

# Firebase Analytics:
# - configured via native files (`google-services.json` / `GoogleService-Info.plist`) + Expo config plugins

# ─── Meta App Events (ads measurement — native EAS builds only) ───────────────
# Meta Developers → your app → Settings → Basic: App ID + Client Token.
# Also set these in EAS Environment Variables for preview/production builds.
# Without both values, the FBSDK config plugin is skipped (Expo Go / local UI still works).
# After enabling: rebuild with EAS — Meta SDK does not load in Expo Go.
# EXPO_PUBLIC_FACEBOOK_APP_ID=
# EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=

# Backend-only secrets → backend/.env.example (OPENROUTER_API_KEY, Razorpay, Play, etc.)
