# Prototype APK — copy values into EAS Secrets or export before `npm run build:apk`.
# Local `.env` is NOT used by EAS cloud builds unless you pass vars via `eas secret` or CLI.
#
# REQUIRED for a shareable APK (phones cannot reach localhost / LAN):
EXPO_PUBLIC_AGASTYA_API_URL=https://YOUR-DEPLOYED-API.example.com

# REQUIRED for sign-in / cloud sync in the prototype:
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# OPTIONAL — leave empty for prototype; paywall IAP will be disabled without keys:
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=premium

# OPTIONAL — crash reporting / analytics:
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_POSTHOG_KEY=
