# Expo / EAS environment variables for the Agastya app.
# Add these in Expo/EAS as project environment variables, or copy to `.env`
# for local Expo runs. These are client-bundled values, so do NOT put backend
# secrets here.

# Required for APK/production builds. Must be a public HTTPS backend URL.
EXPO_PUBLIC_AGASTYA_API_URL=https://agastya-production-63c1.up.railway.app

# Required for sign-in and cloud sync.
# Supabase Dashboard -> Project Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Optional auth toggles. Omit these to keep both enabled.
# Set to false only if you want to hide that option.
# EXPO_PUBLIC_EMAIL_SIGNIN=false
# EXPO_PUBLIC_OAUTH_SIGNIN=false

# Optional RevenueCat in-app purchase keys.
# Required only when you want native subscriptions/paywall unlocks.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=premium

# Optional web billing toggle for Stripe Checkout.
# Use only for web builds when the backend Stripe envs are configured.
# EXPO_PUBLIC_STRIPE_CHECKOUT_ENABLED=true

# Optional crash reporting.
EXPO_PUBLIC_SENTRY_DSN=

# Optional analytics. Use PostHog OR Mixpanel.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_MIXPANEL_TOKEN=

# Local physical-device development only. Do not use this in EAS production.
# EXPO_PUBLIC_AGASTYA_API_LAN_URL=http://YOUR_PC_LAN_IP:8000
