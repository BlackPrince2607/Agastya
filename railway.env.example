# Railway Dashboard → your service → Variables
# Copy each line (without # comments) and paste values. Never commit real secrets.
#
# After deploy: copy the public URL (Settings → Networking → Generate Domain)
# into EXPO_PUBLIC_AGASTYA_API_URL for the APK build.

# ─── Deploy via GitHub (pick one) ─────────────────────────────────────────────
#
# A) Railway native (recommended — no GitHub Actions secrets):
#    1. Push this repo to GitHub
#    2. railway.app → New Project → Deploy from GitHub repo → select Agastya
#    3. Railway reads railway.toml + backend/Dockerfile automatically
#    4. Set variables below in Railway Dashboard → Variables
#    5. Settings → Networking → Generate Domain
#
# B) GitHub Actions (this repo's .github/workflows/backend-deploy.yml):
#    GitHub → Settings → Secrets and variables → Actions
#    Secrets:  RAILWAY_TOKEN  (Railway → Account Settings → Tokens)
#    Variables: RAILWAY_SERVICE_ID  (optional — service → Settings → Service ID)
#    Push to main (backend/** or railway.toml changes) triggers deploy.

# ─── Required ─────────────────────────────────────────────────────────────────
DEBUG=false
PALM_ANALYSIS_MODE=vision
API_V1_PREFIX=/v1

OPENROUTER_API_KEY=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Mobile APK / native apps do not use browser CORS; this is for Expo web if needed.
CORS_ORIGINS=https://agastya.app,http://localhost:8081

# ─── Optional (prototype can skip) ────────────────────────────────────────────
# Razorpay + Google Play User Choice billing (Android India)
# BILLING_RAZORPAY_ENABLED=true
# BILLING_RAZORPAY_ANDROID_ENABLED=true
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_AMOUNT_MONTHLY_PAISE=100
# RAZORPAY_AMOUNT_ANNUAL_PAISE=200
# BILLING_RAZORPAY_COUNTRIES=IN
# BILLING_FORCE_COUNTRY=IN
# Temporary for Expo Go / first live ₹1 E2E (bypass needs DEBUG=true):
# DEBUG=true
# BILLING_RAZORPAY_TEST_BYPASS=true
# PLAY_PACKAGE_NAME=com.agastya.app
# CHECKOUT_ALLOWED_RETURN_ORIGINS=https://agastya.app,agastya://,exp://

# Shared rate limits if you scale workers above 1 (Railway Redis / Upstash)
# REDIS_URL=

# Lock Host header to your Railway domain (recommended once you have a custom domain)
# TRUSTED_HOSTS=agastya-production-eb56.up.railway.app

# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
